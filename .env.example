# Claude Ads — Environment Variables
# Copy this file to .env and fill in your values.
# Add to your shell profile (~/.zshrc or ~/.bash_profile) with: source ~/.env
#
# DO NOT commit .env to git — it contains secrets.
# This file (.env.example) is safe to commit — it has no real values.

# ─────────────────────────────────────────────────────────────────────────────
# META ADS (required for /ads meta and /ads instagram)
# ─────────────────────────────────────────────────────────────────────────────

# Long-lived access token (valid ~60 days, then refresh)
# Get it: https://developers.facebook.com/tools/explorer/
# Required scopes: ads_read, instagram_basic, instagram_manage_insights,
#                  pages_read_engagement, business_management
META_ACCESS_TOKEN=""

# Your Meta Ads account ID (format: act_XXXXXXXXXX)
# Find it: Meta Business Suite → Settings → Ad Accounts
META_AD_ACCOUNT_ID=""

# Your Facebook Business Manager ID
# Find it: business.facebook.com/settings → Business Info → Business ID
META_BUSINESS_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE ADS (required for /ads google and /ads youtube)
# ─────────────────────────────────────────────────────────────────────────────

# Developer token — apply at: https://developers.google.com/google-ads/api/docs/get-started/dev-token
# Note: takes 1-2 business days to approve for new applications
GOOGLE_ADS_DEVELOPER_TOKEN=""

# OAuth2 Client ID — from Google Cloud Console
# https://console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
GOOGLE_ADS_CLIENT_ID=""

# OAuth2 Client Secret — same place as Client ID
GOOGLE_ADS_CLIENT_SECRET=""

# Refresh Token — generated by running the auth flow:
#   python3 ~/.claude/skills/ads/scripts/fetch_google_ads.py --auth
GOOGLE_ADS_REFRESH_TOKEN=""

# Google Ads Customer ID (no dashes) — shown in top-right of Google Ads dashboard
# For Sociedad Gourmet accounts:
#   La Única Cumbaya: 6968953180
#   Negroni Quito:    2799220639
#   La Única Cuenca:  9613976299
GOOGLE_ADS_CUSTOMER_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# TIKTOK ADS (required for /ads tiktok)
# ─────────────────────────────────────────────────────────────────────────────

# TikTok for Business App ID
# Create app: https://business-api.tiktok.com/portal/apps
TIKTOK_APP_ID=""

# TikTok App Secret — from the same developer portal
TIKTOK_APP_SECRET=""

# Long-lived Access Token (valid 1 year)
# Generate by running: python3 ~/.claude/skills/ads/scripts/fetch_tiktok_ads.py --auth
TIKTOK_ACCESS_TOKEN=""

# Advertiser ID — visible in TikTok Ads Manager URL after ?advertiser_id=
TIKTOK_ADVERTISER_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# IMAGE GENERATION (required for /ads generate and /ads photoshoot)
# ─────────────────────────────────────────────────────────────────────────────

# Google API Key for Gemini / Imagen 4
# Get it: https://aistudio.google.com/app/apikey (free tier available)
GOOGLE_API_KEY=""
